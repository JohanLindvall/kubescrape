    given-names: Johan
repository-code: "https://github.com/JohanLindvall/kubescrape"
url: "https://github.com/JohanLindvall/kubescrape"
license: MIT
keywords:
  - kubernetes
  - observability
  - opentelemetry
  - otlp
  - logging
  - log-collector
  - prometheus
  - metrics
  - daemonset
  - go

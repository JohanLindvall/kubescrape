  "additionalProperties": false,
  "definitions": {
    "duration": {
      "type": "string",
      "pattern": "^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
      "description": "A Go duration for a flag.Duration: 30s, 500ms, 1h30m, or a bare 0. helm renders the value VERBATIM into the flag, so whatever time.ParseDuration rejects here is `invalid value for flag` + exit 2 at container start — a CrashLoopBackOff found after the rollout began, instead of a refused helm upgrade. The pattern IS Go's grammar (a unit is required on every non-zero number, so 60 and 1e1 are refused; ns/us/µs/μs/ms/s/m/h only, so no d or w) minus the sign, because every duration in this chart is a period, a timeout or a budget where a negative silently means off or immediate. ONE home for the grammar: every duration value $refs this, which is what keeps a fix from reaching one field and missing its twin"
    },
    "durationOrEmpty": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/definitions/duration"
        }
      ],
      "description": "A duration, or \"\" for the values whose flag is `with`-guarded in the template and simply not rendered when empty. Only those: everywhere else an empty string renders `-flag=`, which is `invalid duration \"\"`"
    },
    "durationOrZero": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        {
          "$ref": "#/definitions/duration"
        }
      ],
      "description": "A duration, or the NUMBER 0 — for the values that values.yaml documents as `0 disables`, which is what an operator copies and which YAML reads as a number. Both forms must stay legal and render the same flag, so `--set x=0` and `--set-string x=0` cannot produce different pods. Both branches need their own guard: the integer branch is bounded to exactly 0 (a bare non-zero number is not a duration), and the string branch needs the pattern because helm's strvals keeps every token it cannot read as an int64 as a STRING — 0.5, abc and 1e1 never reach the number branch at all — while --set-string bypasses it by design"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kubescrape Helm chart values"
